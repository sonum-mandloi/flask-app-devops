pipeline {
  agent any
  stages{
    stage('git clone'){
      steps{
       
        git url: 'https://github.com/sonum-mandloi/flask-app-devops.git', branch: 'main'
      }
    }

      stage('build and push image '){
      steps{
        sh'''
            chmod +x scripts/build.sh
           ./scripts/build.sh
        '''
      }
    }
  }
}

